@model EjustLostAndFoundHub.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />

    <title>@ViewData["Title"] - E-JUST</title>

    <!-- CSS -->
    <!-- 1. Online CSS sources -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">

    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body class="bg-light justify-content-center" style="overflow: hidden;">

    <div class="glass-container login-wrapper">
        <main class="main-content login-bounds">

            <!-- The Header Section -->
            <div class="content-header welcome-header-card bg-white rounded shadow-sm p-5 text-center position-relative mb-4">
                <div class="position-relative z-1">
                    <h2 class="fw-bold text-dark">Welcome to E-JUST Lost & Found Hub</h2>
                    <p class="text-muted">Find your lost items and report found items easily</p>
                </div>

            </div>

            <div class="elements-grid" style="grid-template-columns: 1fr;">

                <div class="element-card">
                    <div class="card-content p-4 p-md-5">

                        <form asp-action="Login" method="post">

                            <!-- Radio Toggle -->
                            <div class="d-flex gap-4 mb-4">
                                <div class="form-check custom-radio">
                                    <input class="form-check-input" type="radio" name="IdType" id="typeNationalId" value="nationalId" checked style="cursor: pointer;">
                                    <label class="form-check-label" for="typeNationalId" style="cursor: pointer; color: var(--dark);">
                                        National ID
                                    </label>
                                </div>
                                <div class="form-check custom-radio">
                                    <input class="form-check-input" type="radio" name="IdType" id="typePassport" value="passport"style="cursor: pointer;">
                                    <label class="form-check-label" for="typePassport" style="cursor: pointer; color: var(--dark);">
                                        Passport Number
                                    </label>
                                </div>
                            </div>

                            <!-- Dynamic Input Field -->
                            <div class="form-group mb-4">
                                <label asp-for="NationalId" id="dynamicLabel" class="fw-bold mb-2 text-dark">National ID</label>

                                <input asp-for="NationalId" class="form-control form-control-lg bg-light border-0"
                                       placeholder="e.g., 30012345678901"
                                       maxlength="14"
                                       type="number" />

                                <span asp-validation-for="NationalId" class="text-danger mt-2 d-block fw-semibold"></span>
                            </div>

                            <div class="card-actions mt-5">
                                <button type="submit" class="btn-primary w-100 border-0 py-3 rounded text-center d-block">
                                    <i class="fas fa-sign-in-alt me-2"></i>
                                    Access Hub
                                </button>
                            </div>
                        </form>

                    </div>
                </div>

            </div>

        </main>
    </div>
</body>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const radios = document.querySelectorAll('input[name="IdType"]');
        const inputField = document.getElementById("NationalId");
        const dynamicLabel = document.getElementById("dynamicLabel");

        radios.forEach(radio => {
            radio.addEventListener("change", function() {
                inputField.value = "";

                if (this.value === "nationalId") {
                    dynamicLabel.textContent = "National ID";
                    inputField.placeholder = "e.g., 30012345678901";
                    inputField.maxLength = 14;
                    inputField.type = "number";
                } else {
                    dynamicLabel.textContent = "Passport Number";
                    inputField.placeholder = "e.g., A12345678";
                    inputField.maxLength = 9;
                    inputField.type = "text";
                }
            });
        });
    });
</script>
</html>
