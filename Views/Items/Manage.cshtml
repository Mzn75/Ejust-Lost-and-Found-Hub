@model IEnumerable<EjustLostAndFoundHub.Models.ItemModel>
@{
    ViewData["Title"] = "Manage Items";
    // Get the Egypt Standard Time zone
    var egyptTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Egypt Standard Time");
}

<!-- Mobile Menu Button -->
<button class="mobile-menu-btn d-lg-none">
    <i class="fas fa-bars"></i>
</button>

<!-- Main Content -->
<div class="glass-container overflow-auto vh-100 pb-5">
    <main class="main-content">

        <!-- The Header Section -->
        <div class="content-header welcome-header-card bg-white rounded shadow-sm p-5 text-center position-relative mb-4">
            <i class="fa-solid fa-pencil faded-watermark-icon"></i>
            <h2 class ="fw-bold text-dark">Manage Items</h2>
            <p class="text-muted">Select an item below to update its details or remove it from the system.</p>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="feed-list mb-5">

                @foreach (var item in Model)
                {
                    var localTime = TimeZoneInfo.ConvertTimeFromUtc(item.DateReported, egyptTimeZone);

                    <div class="element-card freeze-hover feed-card-horizontal">

                        <!-- Left Side: Image or Fallback Icon -->
                        <div class="item-thumbnail">
                            @if (!string.IsNullOrEmpty(item.PhotoPath))
                            {
                                <img src="@item.PhotoPath" alt="Item" class="item-thumbnail-img" />
                            }
                            else
                            {
                                string iconClass = "fa-box";
                                switch (item)
                                {
                                    case EjustLostAndFoundHub.Models.IdItem: iconClass = "fa-id-card"; break;
                                    case EjustLostAndFoundHub.Models.WalletItem: iconClass = "fa-wallet"; break;
                                    case EjustLostAndFoundHub.Models.DeviceItem: iconClass = "fa-mobile-screen"; break;
                                    case EjustLostAndFoundHub.Models.JewelryItem: iconClass = "fa-ring"; break;
                                    case EjustLostAndFoundHub.Models.NotebookItem: iconClass = "fa-book"; break;
                                }

                                <div class="d-flex align-items-center justify-content-center item-thumbnail-fallback">
                                    <i class="fa-solid @iconClass fa-2x" style="color: var(--secondary);"></i>
                                </div>
                            }
                        </div>

                        <!-- Middle: Details -->
                        <div class="item-details">
                            <h4 class="mb-1 item-title">
                                @switch (item)
                                {
                                    case EjustLostAndFoundHub.Models.IdItem idCard:
                                        @($"ID: {idCard.IdNumber}")
                                        break;
                                    case EjustLostAndFoundHub.Models.DeviceItem device:
                                        @($"{device.DeviceBrand} {device.DeviceModel}")
                                        break;
                                    case EjustLostAndFoundHub.Models.WalletItem wallet:
                                        @($"{wallet.WalletColor} Wallet")
                                        break;
                                    case EjustLostAndFoundHub.Models.JewelryItem jewelry:
                                        @($"{jewelry.JewelryMaterial} {jewelry.JewelryType}")
                                        break;
                                    case EjustLostAndFoundHub.Models.NotebookItem notebook:
                                        @($"{notebook.NotebookColor} Notebook")
                                        break;
                                    default:
                                        @item.Category
                                        break;
                                }
                            </h4>

                            <div class="item-description">
                                @switch (item)
                                {
                                    case EjustLostAndFoundHub.Models.IdItem idCard:
                                        <strong>Name on ID: </strong> 
                                        @idCard.IdName
                                        break;
                                    case EjustLostAndFoundHub.Models.WalletItem wallet:
                                        <strong>Description:</strong> 
                                        @wallet.WalletColor @wallet.WalletBrandOrMaterial
                                        break;
                                    case EjustLostAndFoundHub.Models.DeviceItem device:
                                        <strong>Description:</strong> 
                                        @device.DeviceDescription
                                        break;
                                    case EjustLostAndFoundHub.Models.JewelryItem jewelry:
                                        <strong>Description:</strong> 
                                        @jewelry.JewelryMaterial @jewelry.JewelryType
                                        break;
                                    case EjustLostAndFoundHub.Models.NotebookItem notebook:
                                        <strong>Color:</strong> 
                                        @notebook.NotebookColor
                                        break;
                                }
                                <br />
                                <strong>Found at:</strong> @item.LocationFound <br />
                                <strong>Reported:</strong> @localTime.ToString("MMM dd yyyy 'at' hh:mm tt")
                            </div>
                        </div>

                        <!-- Far Right: Admin Actions -->
                        <div class="item-actions d-flex flex-column justify-content-center gap-2">

                            <a href="@Url.Action("Edit", "Items", new { id = item.Id })" class="btn-primary text-center">
                                <i class="fas fa-edit me-2"></i> Edit
                            </a>

                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="m-0" onsubmit="return confirm('Are you sure you want to completely delete this item?');">
                                <button type="submit" class="search-btn">
                                    <i class="fas fa-trash me-2"></i> Delete
                                </button>
                            </form>

                        </div>
                    </div>
                }
            </div>

            <!-- Pagination Controls (Only shows if there are multiple pages) -->
            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center mb-0">

                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Edit", new { page = ViewBag.CurrentPage - 1 })">Previous</a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Edit", new { page = i })">@i</a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Edit", new { page = ViewBag.CurrentPage + 1 })">Next</a>
                        </li>

                    </ul>
                </nav>
            }
        }
        else
        {
            <div class="empty-state text-center form-stacked empty-state-large d-flex flex-column align-items-center">
                <i class="fa-solid fa-box-open mb-4 empty-state-icon-large"></i>
                <h3 class="empty-state-title mb-3">No Items Found</h3>
                <p class="empty-state-desc mb-4">There are currently no items in the database to manage.</p>
            </div>
        }

    </main>
</div>