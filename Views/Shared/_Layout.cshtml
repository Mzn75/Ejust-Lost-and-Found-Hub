<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    
    <title>@ViewData["Title"] - E-JUST</title>

    <!-- CSS -->
    <!-- 1. Online CSS sources -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">

    <!-- 2. Base Variables & Global Element Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- 3. Main Containers & Structural Grid Skeleton -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    <!-- 4. Global Reusable Elements (Buttons, Form Inputs, Cards, SweetAlert) -->
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />

    <!-- 5. Target View Contexts (Item Details, Search Page Elements) -->
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />

    <!-- 6. Breakpoint Definitions & Interactive Mobile Component Formats -->
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
</head>

<body class="@(ViewData["LockScroll"] != null && (bool)ViewData["LockScroll"] ? "lock-scroll" : "")">

    <!-- Sidebar Navigation -->
    <nav class="sidebar">

        <!-- Logo Section -->
        <div class="logo">
            <h1>E-JUST <br /> Lost & Found Hub</h1>
        </div>

        <!-- Gretting User -->
        <div class="user-info">
            <div class="welcome-text">Welcome</div>
            <!--Will be got from a db later-->
            <!-- <div class="user-name">User Name</div> -->
        </div>

        <!-- SideBar Navigation Links -->
        <ul class="nav-links">
            <li>
                <a asp-controller="Home" asp-action="Index">
                    <i class="fas fa-home"></i>
                    Dashboard
                </a>
            </li>
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a asp-controller="Items" asp-action="Manage">
                        <i class="fas fa-pencil me-2"></i>
                        Manage Items
                    </a>
                </li>
            }
            <li>
                <a asp-controller="Items" asp-action="LostItems">
                    <i class="fas fa-search me-2"></i>
                    Lost Items
                </a>
            </li>
            <li>
                <a asp-controller="Items" asp-action="FoundItems">
                    <i class="fas fa-box-open me-2"></i>
                    Found Items
                </a>
            </li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link-button">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </button>
                </form>
            </li>
            <li>
                <p class="text-white-50 small" style="font-size: 0.85rem; letter-spacing: 1px;">Developed by <br /> </p>
                <span class="fw-bold text-white">
                    <a class="dev-by" href="https://mazen-thobian.tech" target="_blank"> <i class="fa-solid fa-link"></i> Mazen Thobian
                    </a>
                </span>
            </li>
        </ul>
    </nav>

    <div>
        <main role="main">
            @* Whenever a user visits a page, ASP.NET grabs the specific view they requested (like LostItems.cshtml or Details.cshtml) and injects all of its HTML right here.*@
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <!-- 1. Online Scripts-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25" integrity="sha384-nLoOnA/BDh8A/jxqtckg4DumuCGOBYUnNJLZdQz/zfYNp3wcjGSoWTAzgko06G/2" crossorigin="anonymous"></script>

    <!-- 2. Local Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
